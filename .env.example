# 复制为 .env.local 后填入真实值。
# .env.local 已被 .gitignore 排除，绝不会进仓库。
#
# 判断某个值该不该进浏览器包，看前缀就够了：NEXT_PUBLIC_ 是给浏览器的，
# 其余一律不许。当前只有 URL、anon key、站点地址这三个带前缀。

# ════════════════════════════════════════════════════════════
# 最小上线只需要下面 5 个（打 ✅ 的）
# 账号功能那部分（anon key）可以完全不填
# ════════════════════════════════════════════════════════════

# ── DeepSeek ✅ ─────────────────────────────────────────────
# 服务端专用。严禁加 NEXT_PUBLIC_ 前缀，否则会被打进浏览器包。
DEEPSEEK_API_KEY=

# 全局每日调用上限，熔断阈值。默认 300。
# 这个数字的含义是"最坏情况一天最多损失多少"，按你能承受的额度设。
# 另：务必再去 DeepSeek 控制台设一道消费上限 —— 代码里的熔断防的是滥用，
# 控制台的上限才防得住代码本身出错。
DEEPSEEK_DAILY_BUDGET=300

# ── Supabase ✅ ─────────────────────────────────────────────
# Project Settings → API 里取。只需要这两个。
#
# 限流需要跨实例共享计数（Vercel 的函数是无状态的，放内存里等于没限流）。
# 没配 Supabase 时：
#   开发环境 → 退化为进程内内存计数，并打印警告
#   生产环境 → 直接拒绝服务（返回 503），不会敞着口子烧 API 余额
# 所以上线前这两个值必须配好，且要执行 supabase/schema.sql。
NEXT_PUBLIC_SUPABASE_URL=

# 服务端专用，权限最高。泄露等于数据库裸奔，绝不能加 NEXT_PUBLIC_。
SUPABASE_SERVICE_ROLE_KEY=

# ── 支付流程（不需要新变量）─────────────────────────────────
# 支付流程不需要新变量：确认到账由 scripts/confirm-order.mjs 做，
# 它用上面那对 Supabase 变量。收款码是静态资源，放在 public/pay/。
#
# ⚠️ 上线前确认 service_role 仍有 EXECUTE：security.sql 的收口撤掉了 PUBLIC
#    的默认授权，服务端会跟着一起失去权限（报 42501）。核对方法见 README。

# ── 权益凭证 ✅ ─────────────────────────────────────────────
# 服务端专用。签署会员/通行证 cookie 的密钥，≥32 字节随机。
# 泄露 = 任何人可自签会员。轮换会使已发出的全部凭证失效（届时重新发码）。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PASS_SECRET=

# ── 确认页（只在用手机确认到账时需要）───────────────────────
# 站长打开 https://你的域名/admin?key=<这个值> 人工确认到账。
#
# 为什么需要它：付费是"零支付资质"方案（个人收款码，**没有回调**），
# 所以"确认到账"是整条链路唯一的人工环节。原先靠 scripts/confirm-order.mjs，
# 但站长的电脑连不上 Supabase（实测 fetch failed），命令行脚本他跑不了 ——
# 这个页面就是那条替代路径，而它必须挡在钥匙后面。
#
# ⚠️ 服务端专用。**绝不能加 NEXT_PUBLIC_ 前缀** —— 带了前缀的值会被内联进
#    浏览器包，等于把这把钥匙公开挂在页面上，这一整套防护会一起归零；
#    而"忘了加前缀"恰恰是最容易犯的错，所以这里单独写一行提醒。
#
# 未配置时 /admin 与 /api/admin/confirm 一律 404（**不是放行**）：
# 宁可这个页面用不了，也不能因为漏配一个变量就把订单确认面敞开。
#
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# 用法：把生成的值拼进 URL，例如 https://你的域名/admin?key=<值>。
#   手机浏览器打开一次后**存成书签**，之后点一下就能用（每次在手机上敲 43 位不现实）。
#   注意它是 URL 的一部分，会留在浏览器历史里：页面已关掉 referrer、
#   不引用任何外部资源，但这把钥匙本身不要转发给别人。
ADMIN_KEY=

# ── 仅账号功能需要 ──────────────────────────────────────────
# 登录会话用。这个是**公开值**，本来就该出现在浏览器里。
# 不开账号功能就不用填 —— 页头的登录入口会自动隐藏。
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 仅开发用 ────────────────────────────────────────────────
# 没配 Supabase 时用内存兜底核销激活码，方便本地跑通流程。
# 格式 `码:kind:mode:days`，逗号分隔；kind 为 member 时 mode 留空。
# 码必须是 16 位 Crockford base32（去掉了 I L O U）。
#
# ⚠️ 生产环境务必删掉这一行 —— 留着它等于开了一个后门。
# DEV_REDEEM_CODES=XMEMBERDEV30AAA1:member::30,XBAZPASS0000001A:single:bazi:1

# ── 站点地址（建议配）──────────────────────────────────────
# 自定义域名。用于 canonical、Open Graph 与 sitemap.xml。
# 不设时会退化到 Vercel 提供的域名，再退到 localhost:3000 ——
# 正式的搜索引擎收录请务必显式设置。
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
