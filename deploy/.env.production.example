# 复制为 .env.production 后填真实值。**这个文件绝不能进 git。**
#
# 与 .env.local 的区别：这里没有 DEV_REDEEM_CODES（那是本地后门，生产留着等于开后门），
# 多了一个 DOMAIN（Caddy 与 NEXT_PUBLIC_SITE_URL 都从它推导）。

# ── 域名 ────────────────────────────────────────────────────
# 只写域名，不带 https:// 也不带结尾斜杠。
# 必须已经解析到本机公网 IP，否则 Caddy 申请不到证书。
DOMAIN=

# ── DeepSeek ✅ ─────────────────────────────────────────────
# 服务端专用。严禁加 NEXT_PUBLIC_ 前缀，否则会被打进浏览器包。
DEEPSEEK_API_KEY=

# 全局每日调用上限，熔断阈值。
# 另：务必再去 DeepSeek 控制台设一道消费上限 —— 代码里的熔断防的是滥用，
# 控制台的上限才防得住代码本身出错。
DEEPSEEK_DAILY_BUDGET=300

# ── Supabase ✅ ─────────────────────────────────────────────
# 与 .env.local 里的同一对值即可 —— Supabase 项目是外部的，不随服务器搬家。
# Project Settings → API 里取。
NEXT_PUBLIC_SUPABASE_URL=

# 服务端专用，权限最高。泄露等于数据库裸奔，绝不能加 NEXT_PUBLIC_。
SUPABASE_SERVICE_ROLE_KEY=

# ── 权益凭证 ✅ ─────────────────────────────────────────────
# 服务端专用。签署会员/通行证 cookie 的密钥，≥32 字节随机。
#
# ⚠️ 用与 .env.local 里**同一个**值。换一个会让已发出的全部凭证失效 ——
# 已经兑换过激活码的用户会突然发现权益没了。
# 生成（若确实需要新值）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PASS_SECRET=

# ── 不要设的 ────────────────────────────────────────────────
#
# DEV_REDEEM_CODES   —— 本地自测用的内存兜底码。生产环境留着它等于开后门。
#
# NEXT_PUBLIC_SITE_URL —— 不用手写。docker-compose.yml 会从 DOMAIN 推导成
#                         https://${DOMAIN} 传给构建。手写反而容易与 DOMAIN 不一致，
#                         而那种不一致的表现是 sitemap 与 canonical 指向旧域名，
#                         在浏览器里完全看不出来。
