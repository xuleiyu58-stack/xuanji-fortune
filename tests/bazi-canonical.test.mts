/**
 * 钉住排盘的可核对基准点。
 *
 * 为什么需要它：`HomepageSample.tsx` 里那组四柱曾经是**手写**的，而且
 * 那年根本推不出来（辛未月的月干只能是癸，不可能是辛），下面的「依据」
 * 又引用了四柱里不存在的「丑」—— 样张自己拆自己的台。
 *
 * 根因不是粗心，是**当时没有一条能自动发现"这组四柱来自哪一天"的检查**。
 * 手写的干支没有出处，写错了没人会知道。这个文件就是那条检查：
 * 每个基准点都写清**它是怎么来的**，一旦算法漂移，这里立刻红。
 *
 * 基准点的选取原则：挑**能脱离这个库独立核对**的关系，而不是"我记得
 * 某个人的八字是什么"——后者不可靠，我已经在这上面栽过一次
 * （曾把 1992-02-04 的年柱记成庚戌，实际立春之前应为辛未）。
 */
import { test } from "node:test";
import assert from "node:assert/strict";
import { buildBaziChart } from "../src/lib/bazi/index.ts";

const GAN = ["甲", "乙", "丙", "丁", "戊", "己", "庚", "辛", "壬", "癸"];
const ZHI = ["子", "丑", "寅", "卯", "辰", "巳", "午", "未", "申", "酉", "戌", "亥"];

/**
 * 五虎遁：由年干推出各月月干。
 * 口诀：甲己之年丙作首、乙庚之岁戊为头、丙辛必定寻庚起、
 *       丁壬壬位顺行流、戊癸何方发，甲寅之上好追求。
 *
 * 这是**独立于本库**的第二套算法：库改了、这里没改，两者就会打架。
 */
function monthGanByRule(yearGan, monthZhi) {
  const start = {
    甲: "丙", 己: "丙",
    乙: "戊", 庚: "戊",
    丙: "庚", 辛: "庚",
    丁: "壬", 壬: "壬",
    戊: "甲", 癸: "甲",
  }[yearGan];
  const stepsFromYin = (ZHI.indexOf(monthZhi) - ZHI.indexOf("寅") + 12) % 12;
  return GAN[(GAN.indexOf(start) + stepsFromYin) % 10];
}

function pillarsOf(birthDate, birthTime) {
  const chart = buildBaziChart({ birthDate, birthTime, gender: "男" });
  return chart.pillars.map((p) => `${p.gan}${p.zhi}`);
}

test("基准点：2000-01-01 00:30 = 己卯 丙子 戊午 壬子", () => {
  /*
   * 这个日期的价值在于**它能被独立推出**：
   *   · 年柱 —— 在 1999 年立春之后、2000 年立春之前，所以是己卯年（不是庚辰）
   *   · 日柱 —— 万年历对照点，戊午日
   *   · 月柱 —— 己年寅月起丙，子月（距寅 11 位）为丙子
   *   · 时柱 —— 戊日自子时起壬，故子时为壬子
   * 四项各有出处，不依赖"我记得"。
   */
  assert.deepEqual(pillarsOf("2000-01-01", "00:30"), ["己卯", "丙子", "戊午", "壬子"]);
});

test("基准点：2024-01-01 12:00 = 癸卯 甲子 甲子 庚午", () => {
  // 2024 年立春在 02-04，所以元旦仍属癸卯年；癸年寅月起甲，子月为甲子。
  assert.deepEqual(pillarsOf("2024-01-01", "12:00"), ["癸卯", "甲子", "甲子", "庚午"]);
});

test("立春换年柱：1992-02-03 是辛未年，02-05 才是壬申年", () => {
  // 1992 年立春在 02-04。换年柱既不能早一天也不能晚一天 ——
  // 之前正是这里让我误判（我以为 02-04 已经是庚戌年）。
  assert.equal(pillarsOf("1992-02-03", "12:00")[0], "辛未");
  assert.equal(pillarsOf("1992-02-05", "12:00")[0], "壬申");
});

test("所有基准点的月干都符合五虎遁", () => {
  // 这一条是**结构检查**而不是"某天等于某值"：它覆盖所有测到的日子，
  // 所以将来新加日期进来也自动受检。
  const dates = [
    ["2000-01-01", "00:30"],
    ["2024-01-01", "12:00"],
    ["1992-02-03", "12:00"],
    ["1992-02-04", "12:00"],
    ["1992-02-05", "12:00"],
    ["1992-02-04", "07:20"],
    ["1988-08-08", "08:08"],
    ["2010-12-31", "23:30"],
  ];
  for (const [d, t] of dates) {
    const [y, m] = pillarsOf(d, t);
    const expect = monthGanByRule(y[0], m[1]);
    assert.equal(
      m[0],
      expect,
      `${d} ${t}：年柱 ${y}，月支 ${m[1]}，月干应为 ${expect}，实际 ${m[0]}`,
    );
  }
});

test("日柱逐日推进一位（不会被闰年、月末卡住）", () => {
  /*
   * 60 甲子逐日递进是硬约束。这条能抓住"某天算错一天"这类错，
   * 而且不需要知道任何一天"应该"是什么 —— 只需要相邻两天。
   *
   * 注意每一段必须是**连续的**日期。第一版把 1992 与 2000 两段接成了
   * 一条链，中间隔了八年，断言当然差 40 位 —— 测的是我自己写错的清单，
   * 不是被测代码。
   */
  const runs = [
    ["1992-02-28", "1992-02-29", "1992-03-01"],
    ["2000-02-28", "2000-02-29", "2000-03-01"],
    ["2023-12-31", "2024-01-01"],
  ];
  const idx = (gz) => {
    for (let n = 0; n < 60; n++) {
      if (GAN[n % 10] === gz[0] && ZHI[n % 12] === gz[1]) return n;
    }
    throw new Error(`不是合法干支：${gz}`);
  };
  for (const run of runs) {
    const seen = run.map((d) => pillarsOf(d, "12:00")[2]);
    for (let i = 1; i < seen.length; i++) {
      const gap = (idx(seen[i]) - idx(seen[i - 1]) + 60) % 60;
      assert.equal(gap, 1, `${run[i - 1]} → ${run[i]} 日柱应进一位，实际差 ${gap}`);
    }
  }
});
